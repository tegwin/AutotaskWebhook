# Autotask REST API credentials.
# Copy to .env and fill in. Never commit .env.
AUTOTASK_API_USER=
AUTOTASK_API_SECRET=
AUTOTASK_INTEGRATION_CODE=
AUTOTASK_BASE_URL=https://webservices2.autotask.net/ATServicesRest/v1.0

# Defaults used when creating a webhook.
AUTOTASK_WEBHOOK_URL=
AUTOTASK_NOTIFICATION_EMAIL=
AUTOTASK_WEBHOOK_NAME=

# Secret key sent to Autotask with each new webhook.
AUTOTASK_WEBHOOK_SECRET_KEY=change-me

# Flask session signing key.
FLASK_SECRET_KEY=change-me-too

# Web server. 5000 is taken by Docker on this Mac, so use 5001.
PORT=5001
HOST=127.0.0.1
